constant atlas_entry_flag_nine_slice = 1u << 0u;
constant atlas_entry_flag_color_multiplier = 1u << 1u;
constant atlas_entry_flag_autocrop = 1u << 2u;

constant atlas_entry_nine_slice_flag_tiled_x = 1u << 0u;
constant atlas_entry_nine_slice_flag_tiled_y = 1u << 1u;

struct atlas_entry
{
    u1 flags;
    u1 page;
    f2 content_offset;
    f2 content_size;
    f2 uv_min;
    f2 uv_max;
    f2 pixel_size;
    u1 nine_slice_flags;
    f1 nine_slice_left;
    f1 nine_slice_right;
    f1 nine_slice_top;
    f1 nine_slice_bottom;
    u1 color_table_multiplier_index;
};

// We're passing full entry struct which technically causes struct interning in shader code (this is standard behavior
// not only for our compiler, but for glslang too). However, benchmarks do not show significant difference in
// performance as vendor software is usually good at optimizing SPIRV.

// Full atlas sampling function that requires additional arguments to process nine slice images.
f4 sample_atlas (
    in sampler atlas_image_sampler,
    in image_color_2d_array atlas_image_array,
    in atlas_entry entry,
    in f2 element_uv,
    in f2 element_size,
    in f2 element_pixel)
{
    f2 processed_uv = element_uv;
    if ((entry.flags & atlas_entry_flag_nine_slice) != 0u)
    {
        atlas_entry_nine_slice_axis_context_t context_x = atlas_entry_nine_slice_axis_context_t {
            entry.pixel_size.x,
            entry.nine_slice_left,
            entry.nine_slice_right,
            element_size.x,
            element_pixel.x,
            entry.nine_slice_flags & atlas_entry_nine_slice_flag_tiled_x
        };
        
        atlas_entry_nine_slice_axis_context_t context_y = atlas_entry_nine_slice_axis_context_t {
            entry.pixel_size.y,
            entry.nine_slice_top,
            entry.nine_slice_bottom,
            element_size.y,
            element_pixel.y,
            entry.nine_slice_flags & atlas_entry_nine_slice_flag_tiled_y
        };
        
        processed_uv = f2 {
            calculate_entry_space_for_nine_slice_axis (context_x, context_y),
            calculate_entry_space_for_nine_slice_axis (context_y, context_x)
        } / entry.pixel_size;
    }
    
    return sample_atlas_simplified (atlas_image_sampler, atlas_image_array, entry, processed_uv);
}

// Simplified atlas sampling function that ignores nine slice images and
// therefore does not require additional arguments for calculations.
f4 sample_atlas_simplified (
    in sampler atlas_image_sampler,
    in image_color_2d_array atlas_image_array,
    in atlas_entry entry,
    in f2 element_uv)
{
    f2 content_uv = element_uv;
    if ((entry.flags & atlas_entry_flag_autocrop) != 0u)
    {
        content_uv = (content_uv - entry.content_offset) / entry.content_size;
        if (content_uv.x < 0.0 || content_uv.x > 1.0 || content_uv.y < 0.0 || content_uv.y > 1.0)
        {
            return f4 {0.0};
        }
    }
    
    f2 projected_uv = entry.uv_min + content_uv * (entry.uv_max - entry.uv_min);
    return sample (atlas_image_sampler, atlas_image_array, entry.page, projected_uv);
}

struct atlas_entry_nine_slice_axis_context_t
{
    f1 entry_size;
    f1 left;
    f1 right;
    
    f1 element_size;
    f1 pixel;
    
    u1 tiled;
};

// Inner helper function for `calculate_atlas_entry_uv` for calculating coordinates for nine slices.
f1 calculate_entry_space_for_nine_slice_axis (
    in atlas_entry_nine_slice_axis_context_t context,
    // Context of the other axis, needed for correct processing of tiled + non tiled axis combination.
    in atlas_entry_nine_slice_axis_context_t other_context)
{
    f1 sum_borders = context.left + context.right; 
    f1 center_size = context.entry_size - sum_borders;
    
    if (context.element_size > sum_borders)
    {
        if (context.pixel < context.left)
        {
            return context.pixel;
        }
        else if (context.element_size - context.pixel < context.right)
       {
            return context.entry_size - (context.element_size - context.pixel);
        }
        else if (context.tiled != 0u)
        {
            f1 factor = f1 {1.0};
            if (other_context.tiled == 0u &&
                other_context.element_size > other_context.left + other_context.right)
            {
                // Special case when tiling is enabled only on one axis.
                // For that case, we apply uniform scale from scaled axis to tiled axis to avoid non-uniform scaling
                // on visuals.
                
                f1 other_sum_borders = other_context.left + other_context.right;
                f1 other_center_size = other_context.entry_size - other_sum_borders;
                factor = other_center_size / (other_context.element_size - other_sum_borders);
            }
            
            return context.left + (context.pixel - context.left) * factor % center_size;
        }
        else
        {
            f1 stretch_element = (context.pixel - context.left) / (context.element_size - sum_borders);
            return context.left + stretch_element * center_size;
        }
    }
    else
    {
        f1 edge = context.element_size * context.left / sum_borders;
        if (context.pixel < edge)
        {
            return context.pixel;
        }
        else
        {
            return context.entry_size - (context.element_size - context.pixel);
        }
    }
}
